# Never commit the input exports or reconstructed source snapshots.
/repomix-files/**
!/repomix-files/.gitkeep
/reconstructed/
/extracted/
*.repomix.md
*.repomix.xml
*.repomix.json

# Python build and environment artifacts
__pycache__/
*.py[cod]
.pytest_cache/
.coverage
htmlcov/
.venv/
venv/
.build/
build/
dist/
*.egg-info/

# Credentials, IDE state, and OS metadata
.env
.env.*
!.env.example
!.env.sample
!.env.template
.mcp.json
.claude/
.cursor/
.idea/
.DS_Store
__MACOSX/
